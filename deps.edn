{:paths ["src"]

 ;; The version CI pins (JOLT_VERSION in .github/workflows/ci.yml), so the
 ;; floor is a version every push is tested on. A floor set lower is a guess.
 :jolt/min-version "0.8.20"

 ;; No :jolt/native entry: the shim is found at run time in the build
 ;; directory (net.b12n.jolt.openldk/dist-dir), because bridge/build.sh puts it
 ;; in a per-machine cache rather than in this repository.
 :jolt/native []

 :aliases
 {:test {:extra-paths ["test"]}}}
